# Copia este archivo como backend/.env y completa los valores.
# El backend lo carga automáticamente (spring.config.import en application.properties)
# siempre que se ejecute desde la carpeta backend/. El archivo .env está en .gitignore.

# --- Base de datos (obligatorio) ---
DB_URL=jdbc:postgresql://localhost:5432/ecm_db
DB_USERNAME=postgres
DB_PASSWORD=cambia_esto

# --- JWT (obligatorio, mínimo 32 caracteres) ---
# Genera uno con: openssl rand -base64 64
JWT_SECRET=reemplaza_por_un_valor_aleatorio_de_al_menos_32_caracteres

# --- Administrador inicial (lo crea el seeder en el primer arranque) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ecm.com
ADMIN_PASSWORD=cambia_esto

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Correo (opcional) ---
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
